{#
/**
 * Default theme implementation to display a menu.
 */
#}
{% import _self as menus %}

{{ menus.menu_links(items, attributes, 0, is_logged_in, user, profile) }}
{% macro menu_links(items, attributes, menu_level, is_logged_in, user, profile) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul class="main-menu" id="main-menu" {{ attributes.addClass('menu', 'nav', 'navbar-nav') }}>
    {% else %}
      <ul class="submenu">
    {% endif %}
    {% for item in items %}
      <li class="menu-item{{ menu_level == 0 and item.is_expanded ? ' expanded' : '' }}{{ item.is_active ? ' active' : '' }}"{% if item.url %} data-url="{{ item.url }}" {% endif %}>
        {% if item.is_expanded %}
          <a href="{{ item.url }}" class="menu-link">{{ item.title }} <span class="dropdown-toggle"></span></a>
        {% else %}
          <a href="{{ item.url }}" class="menu-link">{{ item.title }}</a>
        {% endif %}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes.removeClass('nav', 'navbar-nav'), menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    {% if is_logged_in %}
      <li class="menu-item full-screen-avatar">
        <a href="/profile/{{ profile.id }}" class="menu-link user-avatar"><i class="fa fa-user-circle"></i></a>
      </li>
    {% endif %}
      <li class="menu-item">
        {% if is_logged_in %}
          <a class="login-btn" href="/user/logout">Logout</a>
        {% else %}
          <a class="login-btn" href="/user/login">Login</a>
        {% endif %}
      </li>
    </ul>
  {% endif %}
{% endmacro %}
