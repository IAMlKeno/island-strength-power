{#
/**
 * Modern Homepage Template for Island Strength & Power
 * Includes hero section with featured carousel
 */
#}

<!-- Header and Navbar -->
<header class="main-header">
  <nav class="navbar navbar-default" role="navigation">
    <div class="container">
      <div class="row">
      <div class="navbar-header col-md-4">
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#main-navigation">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
        {% if page.header %}
          {{ page.header }}
        {% endif %}
      </div>

      <!-- Navigation -->
      <div class="col-md-8">
        {% if page.primary_menu %}
          {{ page.primary_menu }}
        {% endif %}
      </div>
      <!--End Navigation -->

      </div>
    </div>
  </nav>

</header>
<!--End Header & Navbar -->

<!-- Hero Section with Carousel -->
<div class="hero-section">
  <div class="hero-inner">
    <div class="hero-content">
      <h1>Transform Your Strength</h1>
      <p>Expert coaching, proven programs, and a supportive community dedicated to helping you reach your strength training goals.</p>
      <div class="hero-buttons">
        <button class="btn-primary">Start Free Trial</button>
        <button class="btn-secondary">Learn More</button>
      </div>
    </div>
    
    <!-- Featured Classes Carousel -->
    <div class="carousel-mini" data-carousel>
      <div data-slide style="opacity: 0; transition: opacity 0.6s ease;">
        <div class="carousel-image">💪</div>
        <h3 class="carousel-title">Strength Foundations</h3>
        <p class="carousel-schedule">Mon, Wed, Fri • 6:00 PM</p>
        <p class="carousel-description">Build solid foundations with progressive strength training. Perfect for beginners and experienced lifters.</p>
        <div class="carousel-controls">
          <button class="carousel-btn" data-carousel-prev>←</button>
          <button class="carousel-btn" data-carousel-next>→</button>
        </div>
      </div>
      
      <div data-slide style="opacity: 0; transition: opacity 0.6s ease; display: none;">
        <div class="carousel-image">🏋️</div>
        <h3 class="carousel-title">Power & Conditioning</h3>
        <p class="carousel-schedule">Tue, Thu • 5:00 PM</p>
        <p class="carousel-description">Explosive power development combined with functional conditioning for athletic performance.</p>
        <div class="carousel-controls">
          <button class="carousel-btn" data-carousel-prev>←</button>
          <button class="carousel-btn" data-carousel-next>→</button>
        </div>
      </div>
      
      <div data-slide style="opacity: 0; transition: opacity 0.6s ease; display: none;">
        <div class="carousel-image">⚡</div>
        <h3 class="carousel-title">Competition Prep</h3>
        <p class="carousel-schedule">Sat • 10:00 AM</p>
        <p class="carousel-description">Specialized training for lifters preparing for powerlifting and strength competitions.</p>
        <div class="carousel-controls">
          <button class="carousel-btn" data-carousel-prev>←</button>
          <button class="carousel-btn" data-carousel-next>→</button>
        </div>
      </div>
      
      <!-- Carousel Indicators -->
      <div class="carousel-controls" style="margin-top: 16px;">
        <button class="carousel-dot active" data-carousel-dot></button>
        <button class="carousel-dot" data-carousel-dot></button>
        <button class="carousel-dot" data-carousel-dot></button>
      </div>
    </div>
  </div>
</div>

<!-- Main Content -->
<div style="background: white; padding: 80px 32px;">
  <div style="max-width: 1200px; margin: 0 auto;">
    {{ page.content }}
  </div>
</div>
