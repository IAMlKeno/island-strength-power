{#
/**
 * @file
 * Theme override to display a node.
 *
 * Available variables:
 * - node: The node entity with limited access to object properties and methods.
     Only "getter" methods (method names starting with "get", "has", or "is")
     and a few common methods such as "id" and "label" are available. Calling
     other methods (such as node.delete) will result in an exception.
 * - label: The title of the node.
 * - content: All node items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - author_picture: The node author user entity, rendered using the "compact"
 *   view mode.
 * - metadata: Metadata for this node.
 * - date: Themed creation date field.
 * - author_name: Themed author name field.
 * - url: Direct URL of the current node.
 * - display_submitted: Whether submission information should be displayed.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - node: The current template type (also known as a "theming hook").
 *   - node--type-[type]: The current node type. For example, if the node is an
 *     "Article" it would result in "node--type-article". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - node--view-mode-[view_mode]: The View Mode of the node; for example, a
 *     teaser would result in: "node--view-mode-teaser", and
 *     full: "node--view-mode-full".
 *   The following are controlled through the node publishing options.
 *   - node--promoted: Appears on nodes promoted to the front page.
 *   - node--sticky: Appears on nodes ordered above other non-sticky nodes in
 *     teaser listings.
 *   - node--unpublished: Appears on unpublished nodes visible only to site
 *     admins.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - content_attributes: Same as attributes, except applied to the main
 *   content tag that appears in the template.
 * - author_attributes: Same as attributes, except applied to the author of
 *   the node tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 * - view_mode: View mode; for example, "teaser" or "full".
 * - teaser: Flag for the teaser state. Will be true if view_mode is 'teaser'.
 * - page: Flag for the full page state. Will be true if view_mode is 'full'.
 * - readmore: Flag for more state. Will be true if the teaser content of the
 *   node cannot hold the main body content.
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_node()
 *
 * @todo Remove the id attribute (or make it a class), because if that gets
 *   rendered twice on a page this is invalid CSS for example: two lists
 *   in different view modes.
 */
#}
{# {%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%} #}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    not node.isPublished() ? 'node--unpublished',
    'event-modern',
  ]
%}

{# Convenience flags — guards against empty fields #}
{% set has_image = node.hasField('field_banner_image') and node.field_banner_image.value is not empty %}
{% set has_date  = node.hasField('field_event_date')  and node.field_event_date.value  is not empty %}
{% set has_type  = node.hasField('field_event_type')  and node.field_event_type.value  is not empty %}
{% set has_where = node.hasField('field_event_location')    and node.field_event_location.value    is not empty %}
{% set has_price = node.hasField('field_registration_price') and node.field_registration_price.value is not empty %}

<script src="https://cdn.jsdelivr.net/npm/add-to-calendar-button@2" async defer></script>
<article{{ attributes.addClass(classes) }}>
{# {{content}} #}
  {# ── HERO BAND ───────────────────────────────────────────────── #}
  <header class="event-hero">
    <div class="event-hero__glow" aria-hidden="true"></div>
    <div class="event-hero__inner">

      <nav class="event-breadcrumb">
        <a href="{{ path('<front>') }}">Home</a>
        <span class="sep">/</span>
        <a href="/events">Events</a>
      </nav>

      {% if has_type %}
        <span class="event-pill">{{ content.field_event_type }}</span>
      {% endif %}

      <h1 class="event-title">{{ label }}</h1>

      <div class="event-meta">
        {% if has_date %}
          <span class="event-meta__item">
            <span class="event-meta__icon">📅</span>{{ content.field_event_date.value|date('F j, Y, g:i a') }}
          </span>
        {% endif %}
        {% if has_where %}
          <span class="event-meta__item">
            <span class="event-meta__icon">📍</span>
              {{ content.field_event_location.0['#entity'].field_address.0.locality }} 
              {{ content.field_event_location.0['#entity'].field_address.0.administrative_area }}
          </span>
        {% endif %}
      </div>

    </div>
  </header>

  {# ── BODY: TWO COLUMNS ───────────────────────────────────────── #}
  <div class="event-body">
    <div class="event-body__inner">

      {# Left column — poster + description #}
      <div class="event-main">
        {% if has_image %}
          <div class="event-poster">{{ content.field_banner_image }}</div>
        {% else %}
          <div class="event-poster event-poster--placeholder">
            {# <span class="event-poster__mark">RBC Strongman Corporation Canada</span> #}
            <span class="event-poster__big">{{ label }}</span>
            <span class="event-poster__year">{{ content.field_event_date.value|date('Y') }}</span>
          </div>
        {% endif %}

        <div class="event-description">
          <h2>Event Description</h2>
          {{ content.field_event_description }}
        </div>
      </div>

      {# Right column — sticky info card #}
      <aside class="event-card">
        {{ content.field_registration_form }}
        {% if has_date %}
          <div class="event-card__row">
            <p class="event-card__label">When</p>
            <div class="event-card__value">{{ content.field_event_date.value|date('F j, Y, g:i a') }}</div>
          </div>
        {% endif %}

        {% if has_type %}
          <div class="event-card__row">
            <p class="event-card__label">What</p>
            <div class="event-card__value">{{ content.field_event_type }}</div>
          </div>
        {% endif %}

        {% if has_where %}
          <div class="event-card__row">
            <p class="event-card__label">Where</p>
            <div class="event-card__value">

              <p>{{ content.field_event_location.0['#entity'].field_address.0.address_line1 }}</p>
              <p>{{ content.field_event_location.0['#entity'].field_address.0.locality }}, {{ content.field_event_location.0['#entity'].field_address.0.postal_code }} {{ content.field_event_location.0['#entity'].field_address.0.administrative_area }}</p>
              <p>{{ content.field_event_location.0['#entity'].field_address.0.country_code }}</p>
              </div>
          </div>
        {% endif %}

        {% if has_price %}
          <div class="event-card__price">
            <p class="event-card__label">Registration Price</p>
            <p class="event-card__amount">${{ node.field_registration_price.value }}</p>
          </div>
        {% endif %}

        <div id="payment-message" class="hidden">
          <div class="messages__content"></div>
        </div>

        <div class="event-actions">
          <button class="btn registration-btn" id="registration-btn">Register Now</button>
          <a class="btn btn--ghost" href="#">＋ Add to Calendar</a>
          <add-to-calendar-button
            name="{{ label }}"
            options="'Apple','Google'"
            startDate={{ content.field_event_date.value|date('Y-m-d') }}
            endDate={{ content.field_event_date.value|date('Y-m-d') }}
            location="{{ content.field_event_location.0['#entity'].field_address.0.address_line1 }} {{ content.field_event_location.0['#entity'].field_address.0.locality }}, {{ content.field_event_location.0['#entity'].field_address.0.postal_code }} {{ content.field_event_location.0['#entity'].field_address.0.administrative_area }} {{ content.field_event_location.0['#entity'].field_address.0.country_code }}"
          ></add-to-calendar-button>
        </div>
      </aside>

    </div>
  </div>

  {# Hidden render of any remaining fields so nothing is silently dropped. #}
  <div class="visually-hidden">
    {{ content|without('field_event_type', 'field_event_date', 'field_location', 'field_event_image', 'body', 'field_registration_price', 'field_tested_price', 'field_untested_price', 'links') }}
  </div>
</article>

<script>
  const nid = {{ node.nid.value }};
  const eventInput = document.querySelector('input[type=hidden][name=event]');
  if (eventInput != null) eventInput.value = nid;

  const registrationAmount = {{ (node.field_registration_price.value is not empty) ? node.field_registration_price.value : 0 }};
  const testedAmount = {{ (node.field_tested_price.value is not empty) ? node.field_tested_price.value : 0 }};
  const unTestedAmount = {{ (node.field_untested_price.value is not empty) ? node.field_untested_price.value : 0 }};
</script>
